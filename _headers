# Cabeceras para Cloudflare (equivalen a las de netlify.toml).

/*
  X-Frame-Options: DENY
  X-XSS-Protection: 1; mode=block
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# no-cache NO es "no guardar": el navegador guarda el archivo pero pregunta al
# servidor en cada carga si sigue vigente (normalmente un 304 rápido). Evita que
# un celular se quede con css/js/imágenes viejos si se reemplazan con el mismo nombre.
/assets/*
  Cache-Control: public, no-cache, must-revalidate

/css/*
  Cache-Control: public, no-cache, must-revalidate

/js/*
  Cache-Control: public, no-cache, must-revalidate
